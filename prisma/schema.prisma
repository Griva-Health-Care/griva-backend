generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["node_app"]
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  fullName           String?
  role               String       @default("doctor")
  hospital           String?
  isActive           Boolean      @default(true)
  isAvailable        Boolean      @default(true)
  abhaNumber         String?      @unique
  abhaAddress        String?      @unique
  hprId              String?
  abdmLinked         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  fcmToken           String?
  firebaseUid        String       @unique(map: "User_supabaseUid_key")
  phone              String?
  licenseNumber      String?
  city               String?
  state              String?
  colposcopeSerialNo String?
  abdmSession        AbdmSession?
  patients           Patient[]

  @@schema("node_app")
}

model Patient {
  id          String   @id @default(uuid())
  uuid        String   @unique
  patientName String
  userId      String
  hasReport   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("node_app")
}

model CreditTransaction {
  id                String   @id @default(uuid())
  doctorFirebaseUid String
  delta             Int
  reason            String
  adminUserId       String?
  caseUuid          String?
  createdAt         DateTime @default(now())

  @@index([doctorFirebaseUid], map: "CreditTransaction_doctorUid_idx")
  @@index([createdAt])
  @@schema("node_app")
}

model TeleCase {
  id                  String    @id @default(uuid())
  submittedBy         String
  assignedFirebaseUid String?
  assignedBy          String?
  notes               String?
  files               Json      @default("[]")
  status              String    @default("pending")
  reporterNote        String?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([submittedBy])
  @@index([assignedFirebaseUid], map: "TeleCase_assignedUid_idx")
  @@index([status])
  @@index([createdAt])
  @@schema("node_app")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("node_app")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  caseId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@schema("node_app")
}

model AbdmSession {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("node_app")
}

model doctor_config {
  uid              String   @id
  cloudSyncEnabled Boolean  @default(false)
  role             String   @default("solo")
  creditBalance    Int      @default(0)
  updatedAt        DateTime @default(now())

  @@schema("node_app")
}

model doctor_profiles {
  uid                String   @id
  fullName           String   @default("")
  phone              String   @default("")
  hospital           String   @default("")
  accountType        String   @default("")
  licenseNumber      String   @default("")
  city               String   @default("")
  state              String   @default("")
  colposcopeSerialNo String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@schema("node_app")
}
