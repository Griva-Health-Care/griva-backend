# ── Database ──────────────────────────────────────────────────────────────────
# RDS PostgreSQL connection string (schema=node_app is stripped internally by prisma.ts)
DATABASE_URL="postgresql://user:password@your-rds-host.rds.amazonaws.com:5432/griva?schema=node_app&sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
ALLOWED_ORIGINS="*"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret key for signing/verifying JWTs. Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-secret"

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Region and bucket name for media uploads.
# No AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY needed — uses EC2 instance role.
AWS_REGION="ap-south-1"
S3_BUCKET="griva-media"

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID="griva-app-18f0f"
# Path to the Firebase service account JSON file on disk (for FCM)
GOOGLE_APPLICATION_CREDENTIALS="/home/ec2-user/griva-firebase-adminsdk.json"

# ── ABDM ──────────────────────────────────────────────────────────────────────
ABDM_BASE_URL=""
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
