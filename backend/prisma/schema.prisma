generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["node_app", "public"]
}

model User {
  id            String   @id @default(uuid())
  supabaseUid   String   @unique
  email         String   @unique
  fullName      String?
  role          String   @default("doctor")
  hospital      String?
  isActive      Boolean  @default(true)
  isAvailable   Boolean  @default(true)  // tele_reporters toggle this

  // ── ABDM fields (null until user links their ABHA account) ──────────────
  abhaNumber    String?  @unique          // 14-digit ABHA number  e.g. "12-3456-7890-1234"
  abhaAddress   String?  @unique          // ABHA address          e.g. "user@abdm"
  hprId         String?                   // Health Professional Registry ID (doctors / reporters)
  abdmLinked    Boolean  @default(false)  // true once ABHA creation / linking completes
  fcmToken      String?                   // Firebase Cloud Messaging device token

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  abdmSession   AbdmSession?
  patients      Patient[]

  @@schema("node_app")
}

// Lightweight patient record synced from the Flutter app.
// Stores only identity + report flag — full clinical data stays on-device.
model Patient {
  id          String   @id @default(uuid())
  uuid        String   @unique           // stable cross-device UUID from Flutter
  patientName String
  userId      String                     // FK → User.id (doctor or diagnostic center)
  hasReport   Boolean  @default(false)   // true once a PDF report has been generated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("node_app")
}

// Tracks every credit top-up or deduction for a doctor account.
model CreditTransaction {
  id          String   @id @default(uuid())
  doctorUid   String                       // Supabase user UUID of the doctor
  delta       Int
  reason      String
  adminUserId String?
  caseUuid    String?
  createdAt   DateTime @default(now())

  @@index([doctorUid])
  @@index([createdAt])
  @@schema("node_app")
}

model TeleCase {
  id            String    @id @default(uuid())
  submittedBy   String                        // User.id of submitter
  assignedUid   String?                       // Supabase UID of assigned reporter (null = unassigned)
  assignedBy    String?                       // User.id of admin who manually assigned, or "auto"
  notes         String?
  files         Json      @default("[]")      // [{ url, name, type, size }]
  status        String    @default("pending") // pending | assigned | in_review | completed
  reporterNote  String?                       // findings written by the tele_reporter
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([submittedBy])
  @@index([assignedUid])
  @@index([status])
  @@index([createdAt])
  @@schema("node_app")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("node_app")
}

// In-app notifications delivered to a specific user.
// Created by the backend when case status changes (assigned, completed).
model Notification {
  id        String   @id @default(uuid())
  userId    String                        // User.id of recipient
  title     String
  body      String
  caseId    String?                       // optional link back to the TeleCase
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@schema("node_app")
}

// Stores per-user ABDM OAuth tokens after ABHA creation or login.
// One row per user — upserted each time a new token is issued.
model AbdmSession {
  id           String   @id @default(uuid())
  userId       String   @unique             // FK → User.id
  accessToken  String                       // ABDM user-level bearer token
  refreshToken String?                      // provided by some ABDM flows
  expiresAt    DateTime                     // token expiry (typically +10 min)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("node_app")
}

// Doctor / diagnostic-center identity profile.
// In public schema so the Flutter Supabase client can read/write it directly.
model DoctorProfile {
  uid                String   @id            // Supabase user UUID
  fullName           String   @default("")
  phone              String   @default("")
  hospital           String   @default("")
  accountType        String   @default("")   // 'doctor' | 'diagnostic_center'
  licenseNumber      String   @default("")
  city               String   @default("")
  state              String   @default("")
  colposcopeSerialNo String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("doctor_profiles")
  @@schema("public")
}

// Per-doctor cloud configuration managed by the Griva admin panel.
// In public schema so the Flutter Supabase client can read/write it directly.
model DoctorConfig {
  uid               String   @id            // Supabase user UUID
  cloudSyncEnabled  Boolean  @default(false)
  role              String   @default("solo")  // 'solo' | 'clinic' | 'diagnostic' | 'tele_reporter'
  creditBalance     Int      @default(0)
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("doctor_config")
  @@schema("public")
}
