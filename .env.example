# ── Database ──────────────────────────────────────────────────────────────────
# Render PostgreSQL connection string (set automatically via render.yaml)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for dev only.
ALLOWED_ORIGINS="https://grivahealth.com,https://www.grivahealth.com"

# ── Firebase ──────────────────────────────────────────────────────────────────
# Required: your Firebase project ID (for token verification)
FIREBASE_PROJECT_ID="griva-app-18f0f"

# Optional: paste the full service account JSON (minified) for FCM push notifications
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then minify the JSON and paste it here as a single line
FIREBASE_CONFIG=""

# ── ABDM (future) ─────────────────────────────────────────────────────────────
ABDM_BASE_URL=""
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
